# MongoDB Admin Credentials
MONGO_ADMIN_USER=admin
MONGO_ADMIN_PASS=your_admin_password

# MongoDB Application User Credentials
MONGO_USER=dev
MONGO_PASS=your_app_password
MONGO_DB=resume_db
MONGO_AUTH_DB=resume_auth
# Use `localhost` for local MongoDB; use `doc-hub-mongo` when the API runs in Docker Compose.
MONGO_HOST=localhost
MONGO_PORT=27017

# MongoDB Express UI Credentials
BASICAUTH_USER=admin
BASICAUTH_PASS=your_basicauth_password
ADMIN_USER=admin
ADMIN_PASS=your_admin_password
# Optional legacy / tooling; Compose uses MONGO_HOST for mongo-express when set there.
SERVER=localhost
PORTS=8081

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
# Optional: ./build/sh_scripts/configure_dev_logs.sh writes these (see docs/mongo_logging_readme.md)
# UVICORN_LOG_LEVEL=info
# APP_LOG_LEVEL=INFO
# MONGO_LOG_COMMANDS=0   # 1 = PyMongo command tracing in API logs

# Resume HR Portal UI (React) — port when running in Docker
UI_PORT=3000

# Auth & Security (optional but recommended for production)
JWT_SECRET=generate-a-strong-random-secret-for-production
ADMIN_SECRET=secret-required-to-generate-api-keys
